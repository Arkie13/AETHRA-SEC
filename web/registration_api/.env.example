# ---------------------------------------------------------------------------
# AETHRA-SEC registration API - deployment configuration
#
# Copy this file to .env and fill in real values. .env is never committed.
# This service is independent of the desktop app's own .env - it never
# imports from aethra_sec/ and has no access to the desktop app's database.
# ---------------------------------------------------------------------------

# Where the SQLite database file lives. On the droplet this should be on
# persistent disk, outside the directory code deploys overwrite.
AETHRA_REG_DB_PATH=./registrations.db

# Comma-separated list of origins allowed to call this API from a browser.
# The static site's real deployed origin - never "*".
AETHRA_REG_ALLOWED_ORIGINS=http://localhost:5500

# Bearer token required for GET /admin/registrations. Generate a long random
# value for production, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
AETHRA_REG_ADMIN_TOKEN=

# Abuse mitigation on POST /register.
AETHRA_REG_RATE_LIMIT_PER_10MIN=5
AETHRA_REG_MIN_SECONDS_SINCE_LOAD=3
